# ---------------------------------------------------------------------------
# 工程端入库范围：src/ tools/ workbench/ docs/ 文档 geo/*.npz
# 运行期产物、可再生产物、部署端数据 全部排除
# ---------------------------------------------------------------------------

# 运行期 / Python
*.log
*.log.prev*
__pycache__/
*.pyc

# 会话临时产物（截图 / 取色 / 一次性复现脚本）：不进库
.dsh-tmp-shots/
screenshots/

# 运行日志（2026-11-23 起插件直接写工程端 log/）：ucf_mod.log / autotest.txt / player_marks.txt
log/

# 构建产物
build/
*.dll

# 可再生产物（从 geo/*.npz 重建）
geo/web/
geo/tex/

# 本机路径配置
tools/deploy.json

# 部署端数据：只存在于游戏目录，不在工程端（锚定 ucf_mod 根目录，避免误伤 navdata/**）
/nav/
/maps/
/vis/
/markers/
/backup/

# 数据四版：原生备份（冻结只读）/ 开发版 / 测试版统一进库备份
navdata/*.tmp
navdata/native/**/*.tmp
# tools/ 下的一次性脚本（_oneoff/ 除外：那是归档的一次性迁移工具，要进库）
tools/_scratch/
tools/_tmp*
navdata/_logs/
# 录制原始轨迹：临时文件，复盘后的增量只写进 packs，不进库
navdata/dev/vis/rec/

# 根 .gitignore 的 *.zip 规则例外：清理前的工作区备份入库
!navdata/_before_cleanup_*.zip

# 部署弹药库例外：payload 里的 dll 在工程端只有这一份（winhttp.dll 源码已丢失），
# 必须入库，否则游戏目录一旦被清理，加载器和插件就永久没了
!payload/*.dll
!payload/**/*.dll
