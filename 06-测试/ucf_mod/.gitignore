# ---------------------------------------------------------------------------
# 工程端入库范围：src/ tools/ docs/ 文档 geo/*.npz
# 运行期产物、可再生产物、部署端数据 全部排除
# ---------------------------------------------------------------------------

# 运行期 / Python
*.log
*.log.prev*
__pycache__/
*.pyc

# 构建产物
build/
*.dll

# 可再生产物（从 geo/*.npz 重建）
geo/web/
geo/tex/

# 本机路径配置
tools/deploy.json

# 部署端数据：只存在于游戏目录，不在工程端
nav/
maps/
vis/
markers/
backup/
screenshots/

# 数据四版：原生备份进库（冻结、只读），开发版 / 测试版是工作区数据，不进库
navdata/dev/
navdata/test/
navdata/*.tmp/
navdata/_before_cleanup_*.zip
navdata/native/**/*.tmp
tools/_*
navdata/_logs/
