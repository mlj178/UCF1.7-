# ---------------------------------------------------------------------------
# 工程端入库范围：app/ src/ docs/ 文档 + data/geo/*.npz + data/navdata 数据
# 运行期产物、可再生产物、部署端数据 全部排除
#
# 2026-11-24 目录重构后：代码进 app/，数据进 data/，产物进 run/，日志留在 log/
# ---------------------------------------------------------------------------

# 运行期 / Python
*.log
*.log.prev*
__pycache__/
*.pyc

# 会话临时产物（截图 / 取色 / 一次性复现脚本）：不进库
.dsh-tmp-shots/
screenshots/

# 运行日志（插件 + 控制台 + 工具统一写工程端 log/）：
#   ucf_mod.log / ucf_mod.prev.log / ucf_mod.prev_*.log   插件主日志（16 MB 轮转）
#   autotest.txt / player_marks.txt                      车测结果 / 坐标记录
#   navdata.log / navdata.prev.log                       命令行 stdout 抄本（16 MB 轮转）
#   publish.log                                          成品发布流水（TSV）
# 2026-11-27：后两个原来分别在 data/navdata/_logs/ 和 dev/final/，现已收进来。
log/

# 构建产物（run/build/ 下的 dll 也由下面的 *.dll 兜住）
run/build/
run/_tmp*

# 运行时状态（控制台 ↔ 插件的配置 / 命令 / 部署清单）：机器相关，不进库
run/runtime/

# 一键部署的"覆盖前备份"：工程端安全副本，机器相关，不进库
run/deploy_backup/
*.dll

# 可再生产物（从 data/geo/*.npz 重建）
data/geo/web/
data/geo/tex/

# 本机路径配置
app/tools/deploy.json

# 部署端数据：只存在于游戏目录，不在工程端（锚定 ucf_mod 根目录）
# ⚠ /maps/ 是 2026-11-21 之前部署端的点图目录，**已经不用了**。
#    新的地图工程叫 unity-map-project/ —— 别在根目录建 maps/，会被这条规则静默忽略。
/nav/
/maps/
/vis/
/markers/
/backup/

# 数据四版：原生备份（冻结只读）/ 开发版 / 测试版统一进库备份
data/navdata/*.tmp
data/navdata/native/**/*.tmp
# 一次性脚本（_oneoff/ 除外：那是归档的一次性迁移工具，要进库）
app/tools/_scratch/
app/tools/_tmp*
# 2026-11-27 起日志已集中到工程端 log/，这条只兜老位置残留（迁移计划见
# docs/record/日志集中_2026-11-27.md）
data/navdata/_logs/
# 录制原始轨迹：体量大（一场几分钟就上千 MB）、可重录，复盘后的增量只写进 packs，
# 所以不进库
data/navdata/dev/vis/rec/
# ⚠ dev/vis/trace/ 反过来是**故意入库**的：轨迹采集样本体量小（60 Hz 一场几百 KB），
#   是 跳跃报告_*.md 的原始证据，清掉就复现不了。别照 rec/ 的规则顺手加进来。

# 根 .gitignore 的 *.zip 规则例外：清理前的工作区备份入库
!data/navdata/_before_cleanup_*.zip

# 部署弹药库例外：payload 里的 dll 在工程端只有这一份（winhttp.dll 源码已丢失），
# 必须入库，否则游戏目录一旦被清理，加载器和插件就永久没了
!run/payload/*.dll
!run/payload/**/*.dll

# ---------------------------------------------------------------------------
# 地图工程（unity-map-project/）：Unity 生成物不进库，源码/元数据/补丁脚本进库
# ---------------------------------------------------------------------------
unity-map-project/**/Library/
unity-map-project/**/Temp/
unity-map-project/**/Logs/
unity-map-project/**/obj/
unity-map-project/**/UserSettings/
unity-map-project/**/*.csproj
unity-map-project/**/*.sln

# ---------------------------------------------------------------------------
# 地图本体补丁包（run/gamepatch/）：**必须进库**
# 这是"游戏目录里那些改动"的工程端唯一副本（level9 / level12 / globalgamemanagers）。
# 游戏目录一被清理、覆盖、重装，这里是最后的找回点 —— 不要给它加任何排除规则。
# ---------------------------------------------------------------------------
!run/gamepatch/**
!run/gamepatch/**/*

# 台账运行态：每次 scan 的副本矩阵 + 快照（机器相关，不是源码）
run/ledger/
