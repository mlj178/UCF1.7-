        "sniper",
        "handgun"
      ],
      "display_values": {
        "team_death": "团队竞技",
        "special": "刀战",
        "nano4": "生化4（普通生化）",
        "nano6": "生化6（剑客模式）",
        "nano4_terminator": "生化4终结者（多人生化）",
        "sniper": "狙击战",
        "handgun": "手枪战"
      }
    }
