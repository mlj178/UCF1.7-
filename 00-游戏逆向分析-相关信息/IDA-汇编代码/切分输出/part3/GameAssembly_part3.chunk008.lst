.rdata:10BD1078 aGainToApplyToT db 'Gain to apply to the amplitudes defined in the NoiseSettings asse'
.rdata:10BD1078                                         ; DATA XREF: sub_100BFF80+9o
.rdata:10BD10B9                 db 't.  1 is normal.  Setting this to 0 completely mutes the noise.',0
.rdata:10BD10F9                 align 10h
.rdata:10BD1100 aScaleFactorToA db 'Scale factor to apply to the frequencies defined in the NoiseSett'
.rdata:10BD1100                                         ; DATA XREF: sub_100BFFB0+9o
.rdata:10BD1141                 db 'ings asset.  1 is normal.  Larger magnitudes will make the noise '
.rdata:10BD1182                 db 'shake more rapidly.',0
.rdata:10BD1196                 align 4
.rdata:10BD1198 aTargetOffsetFr db 'Target offset from the target object',27h,'s center in target-loc'
.rdata:10BD1198                                         ; DATA XREF: sub_100C0030+9o
.rdata:10BD11D3                 db 'al space. Use this to fine-tune the tracking target position when'
.rdata:10BD1214                 db ' the desired area is not the tracked object',27h,'s center.',0
.rdata:10BD124A                 align 10h
.rdata:10BD1250 aThisSettingWil db 'This setting will instruct the composer to adjust its target offs'
.rdata:10BD1250                                         ; DATA XREF: sub_100C0060+1Fo
.rdata:10BD1250                                         ; sub_100C0530+Ao
.rdata:10BD1291                 db 'et based on the motion of the target.  The composer will look at '
.rdata:10BD12D2                 db 'a point where it estimates the target will be this many seconds i'
.rdata:10BD1313                 db 'nto the future.  Note that this setting is sensitive to noisy ani'
.rdata:10BD1354                 db 'mation, and can amplify the noise, resulting in undesirable camer'
.rdata:10BD1395                 db 'a jitter.  If the camera jitters unacceptably when the target is '
.rdata:10BD13D6                 db 'in motion, turn down this setting, or animate the target more smo'
.rdata:10BD1417                 db 'othly.',0
.rdata:10BD141E                 align 10h
.rdata:10BD1420 aControlsTheSmo db 'Controls the smoothness of the lookahead algorithm.  Larger value'
.rdata:10BD1420                                         ; DATA XREF: sub_100C00C0+Ao
.rdata:10BD1461                 db 's smooth out jittery predictions and also increase prediction lag'
.rdata:10BD14A2                 db 0
.rdata:10BD14A3                 align 8
.rdata:10BD14A8 aIfCheckedMovem db 'If checked, movement along the Y axis will be ignored for lookahe'
.rdata:10BD14A8                                         ; DATA XREF: sub_100C0110+9o
.rdata:10BD14E9                 db 'ad calculations',0
.rdata:10BD14F9                 align 10h
.rdata:10BD1500 aHowAggressivel db 'How aggressively the camera tries to follow the target in the scr'
.rdata:10BD1500                                         ; DATA XREF: sub_100C0140+Ao
.rdata:10BD1541                 db 'een-horizontal direction. Small numbers are more responsive, rapi'
.rdata:10BD1582                 db 'dly orienting the camera to keep the target in the dead zone. Lar'
.rdata:10BD15C3                 db 'ger numbers give a more heavy slowly responding camera. Using dif'
.rdata:10BD1604                 db 'ferent vertical and horizontal settings can yield a wide range of'
.rdata:10BD1645                 db ' camera behaviors.',0
.rdata:10BD1658 aHowAggressivel_0 db 'How aggressively the camera tries to follow the target in the scr'
.rdata:10BD1658                                         ; DATA XREF: sub_100C01A0+Ao
.rdata:10BD1699                 db 'een-vertical direction. Small numbers are more responsive, rapidl'
.rdata:10BD16DA                 db 'y orienting the camera to keep the target in the dead zone. Large'
.rdata:10BD171B                 db 'r numbers give a more heavy slowly responding camera. Using diffe'
.rdata:10BD175C                 db 'rent vertical and horizontal settings can yield a wide range of c'
.rdata:10BD179D                 db 'amera behaviors.',0
.rdata:10BD17AE                 align 10h
.rdata:10BD17B0 aHorizontalScre db 'Horizontal screen position for target. The camera will rotate to '
