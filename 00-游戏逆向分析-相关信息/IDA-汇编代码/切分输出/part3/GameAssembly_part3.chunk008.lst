.rdata:10BC2366                 align 4
.rdata:10BC2368 aMaxKeyframeRed db 'Max keyframe reduction error for the Root.Q/T, LeftFoot IK and Ri'
.rdata:10BC2368                                         ; DATA XREF: sub_100B6060+Ao
.rdata:10BC23A9                 db 'ghtFoot IK channels. Having a larger error value for ',27h,'Key R'
.rdata:10BC23E4                 db 'eduction Error',27h,' and a smaller one for this enables you to o'
.rdata:10BC241F                 db 'ptimize clip data size without the floating feet effect by enabli'
.rdata:10BC2460                 db 'ng ',27h,'Foot IK',27h,' in the Animator.',0
.rdata:10BC247E                 align 10h
.rdata:10BC2480 aFrameRateDivid db 'Frame rate divider for the muscle curves. If you have ',27h,'Fram'
.rdata:10BC2480                                         ; DATA XREF: sub_100B60B0+30o
.rdata:10BC24BB                 db 'e Rate',27h,' set to 30, and this value set to 3, the muscle curv'
.rdata:10BC24F6                 db 'es will be baked at 10 fps. Only the Root Q/T and Hand and Foot I'
.rdata:10BC2537                 db 'K curves will be baked at 30. This enables you to optimize clip d'
.rdata:10BC2578                 db 'ata size without the floating feet effect by enabling ',27h,'Foot'
.rdata:10BC25B3                 db ' IK',27h,' in the Animator.',0
.rdata:10BC25C9                 align 10h
.rdata:10BC25D0 aIfTrueWillFixA db 'If true, will fix all the Transforms used by the solver to their '
.rdata:10BC25D0                                         ; DATA XREF: sub_100B6120+9o
.rdata:10BC2611                 db 'initial state in each Update. This prevents potential problems wi'
.rdata:10BC2652                 db 'th unanimated bones and animator culling with a small cost of per'
.rdata:10BC2693                 db 'formance. Not recommended for CCD and FABRIK solvers.',0
