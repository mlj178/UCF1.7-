.rdata:10BC1A48 aScriptsRootmot db 'Scripts/RootMotion/Baker',0
.rdata:10BC1A48                                         ; DATA XREF: sub_100B5C40+Ao
.rdata:10BC1A61                 align 4
.rdata:10BC1A64 aHttpWwwRootMot db 'http://www.root-motion.com/finalikdox/html/page3.html',0
.rdata:10BC1A64                                         ; DATA XREF: sub_100B5C40+2Eo
.rdata:10BC1A9A                 align 10h
.rdata:10BC1AA0 aInAnimationcli db 'In AnimationClips, AnimationStates or PlayableDirector mode - the'
.rdata:10BC1AA0                                         ; DATA XREF: sub_100B5C90+Ao
.rdata:10BC1AE1                 db ' frame rate at which the animation clip will be sampled. In Realt'
.rdata:10BC1B22                 db 'ime mode - the frame rate at which the pose will be sampled. With'
.rdata:10BC1B63                 db ' the latter, the frame rate is not guaranteed if the player is no'
.rdata:10BC1BA4                 db 't able to reach it.',0
.rdata:10BC1BB8 aMaximumAllowed db 'Maximum allowed error for keyframe reduction.',0
.rdata:10BC1BB8                                         ; DATA XREF: sub_100B5CE0+30o
.rdata:10BC1BE6                 align 4
.rdata:10BC1BE8 aAnimationclips db 'AnimationClips mode can be used to bake a batch of AnimationClips'
.rdata:10BC1BE8                                         ; DATA XREF: sub_100B5D30+9o
.rdata:10BC1C29                 db ' directly without the need of setting up an AnimatorController. A'
.rdata:10BC1C6A                 db 'nimationStates mode is useful for when you need to set up a more '
.rdata:10BC1CAB                 db 'complex rig with layers and AvatarMasks in Mecanim. PlayableDirec'
.rdata:10BC1CEC                 db 'tor mode bakes a Timeline. Realtime mode is for continuous baking'
.rdata:10BC1D2D                 db ' of gameplay, ragdoll phsysics or PuppetMaster dynamics.',0
.rdata:10BC1D66                 align 4
.rdata:10BC1D68 aAnimationclips_0 db 'AnimationClips to bake.',0
.rdata:10BC1D68                                         ; DATA XREF: sub_100B5D60+9o
.rdata:10BC1D80 aTheNameOfTheAn db 'The name of the AnimationStates to bake (must be on the base laye'
.rdata:10BC1D80                                         ; DATA XREF: sub_100B5D90+9o
.rdata:10BC1DC1                 db 'r) in the Animator above (Right-click on this component header an'
.rdata:10BC1E02                 db 'd select ',27h,'Find Animation States',27h,' to have Baker fill t'
.rdata:10BC1E37                 db 'hose in automatically, required that state names match with the n'
.rdata:10BC1E78                 db 'ames of the clips used in them).',0
.rdata:10BC1E99                 align 10h
.rdata:10BC1EA0 aSetsTheBakedAn db 'Sets the baked animation clip to loop time and matches the last f'
.rdata:10BC1EA0                                         ; DATA XREF: sub_100B5DC0+9o
.rdata:10BC1EE1                 db 'rame keys with the first. Note that when overwriting a previously'
.rdata:10BC1F22                 db ' baked clip, AnimationClipSettings will be copied from the existi'
.rdata:10BC1F63                 db 'ng clip.',0
.rdata:10BC1F6C aTheFolderToSav db 'The folder to save the baked AnimationClips to.',0
.rdata:10BC1F6C                                         ; DATA XREF: sub_100B5DF0+9o
.rdata:10BC1F9C                 align 10h
.rdata:10BC1FA0 aStringThatWill db 'String that will be added to each clip or animation state name fo'
.rdata:10BC1FA0                                         ; DATA XREF: sub_100B5E20+9o
.rdata:10BC1FE1                 db 'r the saved clip. For example if your animation state/clip names '
.rdata:10BC2022                 db 'were ',27h,'Idle',27h,' and ',27h,'Walk',27h,', then with ',27h,'_'
.rdata:10BC2046                 db 'Baked',27h,' as Append Name, the Baker will create ',27h,'Idle_Ba'
.rdata:10BC207B                 db 'ked',27h,' and ',27h,'Walk_Baked',27h,' animation clips.',0
.rdata:10BC20A2                 align 4
.rdata:10BC20A4 aNameOfTheCreat db 'Name of the created AnimationClip file.',0
.rdata:10BC20A4                                         ; DATA XREF: sub_100B5E50+9o
