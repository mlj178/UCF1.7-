.rdata:10BD2AA8                                         ; DATA XREF: sub_100C0FC0+Ao
.rdata:10BD2AA8                                         ; sub_100C1B90+2Bo
.rdata:10BD2ABC                 align 10h
.rdata:10BD2AC0 aHowForwardIsDe db 'How ',27h,'forward',27h,' is defined.  The camera will be placed '
.rdata:10BD2AC0                                         ; DATA XREF: sub_100C0FC0+2Eo
.rdata:10BD2AF5                 db 'by default behind the target.  PositionDelta will consider ',27h,'f'
.rdata:10BD2B32                 db 'orward',27h,' to be the direction in which the target is moving.',0
.rdata:10BD2B6D                 align 10h
.rdata:10BD2B70 aSizeOfTheVeloc db 'Size of the velocity sampling window for target heading filter.  '
.rdata:10BD2B70                                         ; DATA XREF: sub_100C1010+Ao
.rdata:10BD2BB1                 db 'This filters out irregularities in the target',27h,'s movement.  '
.rdata:10BD2BEC                 db 'Used only if deriving heading from target',27h,'s movement (Posit'
.rdata:10BD2C27                 db 'ionDelta or Velocity)',0
.rdata:10BD2C3D                 align 10h
.rdata:10BD2C40 aWhereTheCamera db 'Where the camera is placed when the X-axis value is zero.  This i'
.rdata:10BD2C40                                         ; DATA XREF: sub_100C1060+2Eo
.rdata:10BD2C81                 db 's a rotation in degrees around the Y axis.  When this value is 0,'
.rdata:10BD2CC2                 db ' the camera will be placed behind the target.  Nonzero offsets wi'
.rdata:10BD2D03                 db 'll rotate the zero position around the target.',0
.rdata:10BD2D32                 align 8
