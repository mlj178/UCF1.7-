{
  "feature_id": "waypoint_probe",
  "canonical_id": "waypoint_probe",
  "display_name": "路点体检",
  "category": "game_test",
  "tab": "game_test_tab",
  "tab_title": "游戏测试",
  "tab_order": 70,
  "order": 150,
  "desc": "物理探针 + 停战 + 冻结 + 跟随。只在开启后生效；结果写进修改器日志，便于事后分析。",
  "ui_text": {
    "lines": [
      "跑一次物理探针：按人机体积检查每条路点边",
      "停战：清空 enemyInfo.enemy + 全员无敌，人机不开火",
      "冻结：Bot.stopAllBot（游戏自带），人机连走都不走",
      "跟随：用游戏自己的 Seeker 给人机下一条到你的路径，人机沿路点图走过来，全程不开火",
      "采样：记录 bot 走过哪些边"
    ]
  },
  "script": "script.js",
  "runtime": {
    "type": "plugin_script"
  },
  "layout": {
    "card_type": "wide",
    "columnspan": 2,
    "title_color": "#22d3ee"
  },
  "controls": [
    {
      "type": "switch",
      "action": "enable"
    },
    {
      "type": "switch",
      "key": "pacify",
      "label": "停战（人机不开火 + 无敌）",
      "default": false
    },
    {
      "type": "switch",
      "key": "freeze",
      "label": "冻结人机行为（全部不行动）",
      "default": false
    },
    {
      "type": "switch",
      "key": "follow",
      "label": "跟随我（沿路点图走到你身边）",
      "default": false
    },
    {
      "type": "switch",
      "key": "walk",
      "label": "人机采样（走过哪些边）",
      "default": false
    },
    {
      "type": "button",
      "action": "runprobe",
      "label": "跑一次物理探针"
    }
  ],
  "config": {
    "pacify": false,
    "freeze": false,
    "follow": false,
    "walk": false,
    "sample_ms": 200
  },
  "rpc": [
    "enable",
    "disable",
    "setConfig",
    "setconfig",
    "runProbe",
    "runprobe",
    "pathProbe",
    "pathprobe",
    "status",
    "cleanup"
  ],
  "actions": {
    "runprobe": {
      "type": "rpc",
      "requires_connection": true
    }
  },
  "lifecycle": {
    "cleanup": true,
    "restore": false,
    "requires_room_ready_reapply": false,
    "room_ready_retry": false,
    "room_ready_reapply_exempt_reason": "探针/停战/跟随都在 enable 后由定时器持续写入，进图后无需一次性套用；探针为手动按钮触发。"
  },
  "state": {
    "sync_enabled_from_config": false
  },
  "ui_handles": {
    "switch": "waypoint_probe_switch"
  }
}