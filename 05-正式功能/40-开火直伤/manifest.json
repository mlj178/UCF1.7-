{
  "feature_id": "direct_damage",
  "canonical_id": "direct_damage",
  "display_name": "开火直伤",
  "category": "weapon",
  "tab": "weapon_tab",
  "tab_title": "武器",
  "tab_order": 10,
  "order": 89,
  "desc": "常规枪械：开火不走子弹射线，直接把伤害结算到全场最近的敌人（不看准星、可隔墙）。榴弹/手雷/RPG 与特殊技能弹：不做直伤，改为弹体追踪——弹体会拐弯追着敌人飞，伤害仍由原版爆炸结算。弹体追谁由「准星锥内距离最近的敌人」决定（锥角可调，0=回到全场最近；锥内没人可回退全场最近）。三类各有独立开关。",
  "script": "script.js",
  "runtime": {
    "type": "plugin_script"
  },
  "layout": {
    "card_type": "simple",
    "columnspan": 1,
    "title_color": "#f472b6"
  },
  "controls": [
    {
      "type": "switch",
      "action": "enable"
    },
    {
      "type": "switch",
      "action": "setConfig",
      "key": "enable_guns",
      "label": "常规枪械直伤",
      "default": true
    },
    {
      "type": "switch",
      "action": "setConfig",
      "key": "enable_homing",
      "label": "弹体追踪(拐弯) 总开关",
      "default": true
    },
    {
      "type": "switch",
      "action": "setConfig",
      "key": "enable_explosives",
      "label": "榴弹/手雷/RPG 追踪",
      "default": true
    },
    {
      "type": "switch",
      "action": "setConfig",
      "key": "enable_skill_projectiles",
      "label": "特殊技能弹 追踪",
      "default": true
    },
    {
      "type": "slider",
      "action": "setConfig",
      "key": "homing_turn",
      "label": "追踪锁定强度",
      "min": 0.05,
      "max": 1,
      "step": 0.05,
      "default": 1
    },
    {
      "type": "slider",
      "action": "setConfig",
      "key": "homing_cone_deg",
      "label": "追踪·准星锥角度(0=不看准星)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 30
    },
    {
      "type": "switch",
      "action": "setConfig",
      "key": "homing_cone_fallback",
      "label": "锥内没人时回退全场最近",
      "default": true
    },
    {
      "type": "switch",
      "action": "setConfig",
      "key": "use_event_template",
      "label": "真实事件底板(校准wpnIndex)",
      "default": true
    },
    {
      "type": "slider",
      "action": "setConfig",
      "key": "max_angle_deg",
      "label": "准星锥角度",
      "min": 5,
      "max": 120,
      "step": 1,
      "default": 30
    },
    {
      "type": "slider",
      "action": "setConfig",
      "key": "max_distance",
      "label": "最大距离(米)",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80
    }
  ],
  "config": {
    "enable_guns": true,
    "enable_explosives": true,
    "enable_skill_projectiles": true,
    "target_mode": "nearest",
    "max_angle_deg": 30,
    "max_distance": 0,
    "angle_weight": 1,
    "distance_weight": 0.5,
    "damage_entry": "gamemanager",
    "gun_hook_mode": "attach",
    "entry_fallback": true,
    "use_event_template": true,
    "damage_override": 0,
    "fallback_to_original": true,
    "enable_homing": true,
    "homing_speed": 0,
    "homing_turn": 1,
    "homing_retarget": true,
    "homing_max_ms": 20000,
    "homing_pending_ms": 800,
    "homing_cone_deg": 30,
    "homing_cone_fallback": true,
    "death_diag": true,
    "death_diag_ms": 20000,
    "death_diag_detail": false,
    "death_diag_raise": false,
    "death_fix_wpn": false,
    "death_fix_respawn": true,
    "death_respawn_grace_ms": 6000,
    "verbose_probe": true,
    "diagnostic_log": true
  },
  "rpc": [
    "enable",
    "disable",
    "setConfig",
    "set_config",
    "setconfig",
    "status",
    "cleanup"
  ],
  "lifecycle": {
    "cleanup": true,
    "restore": true,
    "requires_room_ready_reapply": false,
    "room_ready_retry": false,
    "room_ready_reapply_exempt_reason": "功能安装固定 RVA Hook（替换 WPN_Gun.Damage + attach 投射物入口），每次开火时按 enabled/config 实时读取房间内玩家列表，不依赖进房时立即写入运行态对象。"
  },
  "source": {
    "single_feature_js": "05-正式功能/40-开火直伤/script.js",
    "runtime_script_js": "features/40_direct_damage/script.js"
  },
  "ui_handles": {
    "switch": "direct_damage_switch",
    "guns_switch": "direct_damage_guns_switch",
    "explosives_switch": "direct_damage_explosives_switch",
    "skills_switch": "direct_damage_skills_switch",
    "template_switch": "direct_damage_template_switch",
    "homing_switch": "direct_damage_homing_switch",
    "homing_turn_slider": "direct_damage_homing_turn_slider",
    "homing_turn_label": "direct_damage_homing_turn_label",
    "homing_cone_slider": "direct_damage_homing_cone_slider",
    "homing_cone_label": "direct_damage_homing_cone_label",
    "homing_cone_fallback_switch": "direct_damage_homing_cone_fallback_switch",
    "angle_slider": "direct_damage_angle_slider",
    "angle_label": "direct_damage_angle_label",
    "distance_slider": "direct_damage_distance_slider",
    "distance_label": "direct_damage_distance_label"
  },
  "state": {
    "sync_enabled_from_config": true
  }
}
